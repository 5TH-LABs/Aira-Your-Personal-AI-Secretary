  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "api": "node server/index.mjs",
    "api:lan": "node server/index.mjs --lan",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "export:web": "expo export --platform web",
    "demo": "node scripts/start-demo.mjs",
    "demo:lan": "node scripts/start-demo.mjs --lan",
    "emulator": "node scripts/emulator.mjs",
    "lint": "expo lint",
    "worker": "node server/start-worker.mjs",
    "verify": "npm run typecheck && npm run lint && npm test",
    "demo:dev": "node scripts/start-demo.mjs --lan --dev-client",
    "cloud:prepare": "node scripts/setup-cloud.mjs --prepare",
    "cloud:check": "node scripts/setup-cloud.mjs",
    "test:ui": "node scripts/build-ui-test.mjs && playwright test",
    "test:ui:run": "playwright test",
    "backup:files": "node scripts/backup-storage.mjs",
    "cloud:sql": "node scripts/setup-cloud.mjs --migrations"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module"
