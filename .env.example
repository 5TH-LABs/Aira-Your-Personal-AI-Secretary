# Server only. Never prefix this key with EXPO_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional for standalone native builds: a reachable HTTPS API origin.
# EXPO_PUBLIC_API_URL=https://your-mobile-api.example.com

# Shared cloud workspace (public anon key; RLS enforces access)
SUPABASE_URL=
SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server and worker only; never use EXPO_PUBLIC for these.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-API/api/v1/google/callback
INTEGRATION_ENCRYPTION_KEY=
AUTH_REDIRECT_URI=winklabz://account
EXPO_ACCESS_TOKEN=

# Separate key for encrypted original-file backups.
BACKUP_ENCRYPTION_KEY=
# Restore only into a separate project; never the source.
RESTORE_SUPABASE_URL=
RESTORE_SUPABASE_SERVICE_ROLE_KEY=
RESTORE_CONFIRM_HOST=
