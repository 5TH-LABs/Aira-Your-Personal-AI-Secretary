{
  "expo": {
    "name": "Site Office",
    "slug": "winklabz-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.winklabz.siteoffice",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Use your voice to ask your construction office for help."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4edff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.winklabz.siteoffice",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/office-favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Site Office to record your spoken requests.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-asset"
    ],
    "scheme": "winklabz",
    "backgroundColor": "#fbfbfe"
  }
}
